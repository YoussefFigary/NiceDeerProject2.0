
@model IEnumerable<NorthwindTraders.Models.Product>
@{
    ViewBag.Title = "Products";

}
<head>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @*bootstrap icons*@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>
<main>
    <div class="d-flex align-items-center mb-3">
        <h1 class="display-4 mb-0 me-3" style="line-height: 1;">Products</h1>
        <button type="button" class="btn btn-success btn-lg" onclick="AddOrEditProduct(0)">Add Product</button>
    </div>



    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Product ID</th>
                <th>Product Name</th>
                <th>Unit Price</th>
                <th>Units In Stock</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ProductID</td>
                    <td>@item.ProductName</td>
                    <td>@item.UnitPrice</td>
                    <td>@item.UnitsInStock</td>
                    <td>
                        <div class="btn-group">
                            <button type="button" class="btn btn-dark" onclick="productDetails('@item.ProductID')"> <i class="bi bi-eye-fill"></i></button>
                            <button type="button" class="btn btn-primary" onclick="AddOrEditProduct('@item.ProductID')"><i class="bi bi-pencil-fill"></i></button>
                            <button type="button" class="btn btn-danger" onclick="DeleteProduct('@item.ProductID')"><i class="bi bi-trash3-fill"></i></button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="modal fade" id="productDetailsModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Product Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="productDetailsModalBody">

                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="productEditModal" tabindex="-1" aria-labelledby="productEditModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="productEditModalLabel"></h5> <!-- title will be set dynamically -->
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body" id="productEditModalBody">
                    <!-- Partial view will load here -->
                </div>



            </div>
        </div>
    </div>

</main>
<script>
    function productDetails(id) {
        $.ajax({
            url: `/Products/Details?id=${id}`, // Calls CustomersController.Details
            type: 'GET',
            dataType: 'html',
            success: function (partialViewHtml) {
                $("#productDetailsModalBody").html(partialViewHtml);
                $("#productDetailsModal").modal('show');
            },
            error: function (xhr, status, error) {
                Swal.fire("Error", "Could not load product details", "error");
            }
        });
    }
   function AddOrEditProduct(id) {
        $.ajax({
            url: `/Products/AddOrEditPopup?id=${id}`,
            type: 'GET',
            dataType: 'html',
            success: function (partialViewHtml) {
                $("#productEditModalBody").html(partialViewHtml);
                // set title depending on add or edit
                if (id == 0 ) {
                    $("#productEditModalLabel").text("Add Product");
                } else {
                    $("#productEditModalLabel").text("Edit Product");
                }

                $("#productEditModal").modal('show');
            },
            error: function () {
                Swal.fire("Error", "Could not load form", "error");
            }
        });
    }

    function saveProduct() {
        var formData = $("#addoredit-product-form").serialize();
        $.ajax({
            url: '/Products/SaveEdit',  // POST to save changes
            type: 'POST',
            data: formData,
            success: function (result) {
                if (result.success) {
                    Swal.fire("Success", "Product updated successfully!", "success")
                        .then(() => location.reload());
                } else {
                    Swal.showValidationMessage("Error updating product");
                }
            },
            error: function () {
                Swal.showValidationMessage("Error while saving product");
            }
        });
    }
    function DeleteProduct(id) {
        Swal.fire({
            title: "Are you sure?",
            text: "This will permanently delete the product.",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Yes, delete it!",
            cancelButtonText: "Cancel"
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/Products/Delete',
                    type: 'POST',
                    data: { id: id },
                    success: function (result) {
                        if (result.success) {
                            Swal.fire("Deleted!", result.message, "success")
                                .then(() => location.reload());
                        } else {
                            Swal.fire("Blocked", result.message, "error");
                        }
                    },
                    error: function () {
                        Swal.fire("Error", "An error occurred while deleting.", "error");
                    }
                });
            }
        });
    }
    function validateAndSaveProduct() {
        var form = document.getElementById('addoredit-product-form');

        // check Bootstrap validation
        if (form.checkValidity()) {
            saveProduct(); // ✅ only call if valid
        } else {
            form.classList.add('was-validated'); // show errors
        }
    }

</script>

