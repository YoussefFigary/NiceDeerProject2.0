@model Northwind.DTO.ProductVM
@{
    var supplierID = ViewBag.SupplierID as List<int>;
}

<form id="addoredit-product-form" class="row g-3 needs-validation" novalidate>
    @Html.HiddenFor(m => m.ProductID)

    <!-- Product Name -->
    <div class="col-md-6">
        <label class="form-label">Product Name</label>
        <input name="ProductName" value="@Model.ProductName" class="form-control" placeholder="Product Name" required />
        <div class="invalid-feedback">Product name is required.</div>
    </div>

    <!-- Supplier ID -->
    <div class="col-md-6">
            @Html.LabelFor(m => m.SupplierID, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.SupplierID, new { @class = "form-control", type = "number", placeholder = "Supplier ID" })
            <div class="invalid-feedback">Supplier ID is required.</div>
    
    </div>
    <!-- Category ID -->
    <div class="col-md-6">
        @Html.LabelFor(m => m.CategoryID, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.CategoryID, new { @class = "form-control", type = "number", placeholder = "Category ID" })
        <div class="invalid-feedback">Category ID is required.</div>
    </div>

    <!-- Quantity Per Unit -->
    <div class="col-md-6">
        <label class="form-label">Quantity Per Unit</label>
        <input name="QuantityPerUnit" value="@Model.QuantityPerUnit" class="form-control" placeholder="e.g. 24-box" required />
        <div class="invalid-feedback">Quantity per unit is required.</div>
    </div>

    <!-- Unit Price -->
    <div class="col-md-4">
        <label class="form-label">Unit Price</label>
        <input name="UnitPrice" type="number" step="0.01" value="@Model.UnitPrice" class="form-control" placeholder="Unit Price" required />
        <div class="invalid-feedback">Unit price is required.</div>
    </div>

    <!-- Units In Stock -->
    <div class="col-md-4">
        <label class="form-label">Units In Stock</label>
        <input name="UnitsInStock" type="number" value="@Model.UnitsInStock" class="form-control" placeholder="Units In Stock" required />
        <div class="invalid-feedback">Units in stock is required.</div>
    </div>

    <!-- Units On Order -->
    <div class="col-md-4">
        <label class="form-label">Units On Order</label>
        <input name="UnitsOnOrder" type="number" value="@Model.UnitsOnOrder" class="form-control" placeholder="Units On Order" />
    </div>

    <!-- Reorder Level -->
    <div class="col-md-4">
        <label class="form-label">Reorder Level</label>
        <input name="ReorderLevel" type="number" value="@Model.ReorderLevel" class="form-control" placeholder="Reorder Level" />
    </div>

    <!-- Discontinued -->
    <div class="col-md-4">
        <label class="form-label">Discontinued</label>
        <select name="Discontinued" class="form-select">
            <option value="false" @(Model.Discontinued == false ? "selected" : "")>No</option>
            <option value="true" @(Model.Discontinued == true ? "selected" : "")>Yes</option>
        </select>
    </div>

    <!-- Footer Buttons -->
    <div class="col-12 d-flex justify-content-end mt-3">
        <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" onclick="validateAndSaveProduct()">Save</button>
    </div>
</form>
