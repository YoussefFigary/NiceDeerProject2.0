
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

@model IEnumerable<NorthwindTraders.Models.Category>

<table class="table table-hover table-striped no-border-table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Description</th>
            <th style="width:150px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr id="row_@item.CategoryID">
                <td>@item.CategoryID</td>
                <td>@item.CategoryName</td>
                <td>@item.Description</td>
                <td>
                    <div class="btn-group" role="group">
                        <button class="btn btn-primary btn-sm edit-category"
                                data-id="@item.CategoryID"
                                data-name="@item.CategoryName"
                                data-desc="@item.Description"
                                title="Edit">
                            <i class="bi bi-pencil-fill"></i>
                        </button>
                        <button class="btn btn-danger btn-sm delete-category"
                                data-id="@item.CategoryID"
                                title="Delete">
                            <i class="bi bi-trash-fill"></i>
                        </button>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

