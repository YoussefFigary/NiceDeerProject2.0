@model IEnumerable<NorthwindTraders.Models.Category>

@{
    ViewBag.Title = "Categories";
}

<div class="container mt-4">
    <h2>Categories</h2>

    <div class="mb-3">
        <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#categoryModal">
            Add New Category
        </button>
    </div>

    <div id="categoryTable">
        @Html.Partial("_CategoryTable", Model)
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="categoryModal" tabindex="-1" aria-labelledby="categoryModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content rounded-3 shadow">
            <div class="modal-header">
                <h5 class="modal-title" id="categoryModalLabel">Add / Edit Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="categoryForm">
                    <input type="hidden" id="CategoryID" name="CategoryID" value="" />

                    <div class="mb-3">
                        <label for="CategoryName" class="form-label">Category Name</label>
                        <input type="text" class="form-control" id="CategoryName" name="CategoryName" required />
                        <div class="invalid-feedback" id="CategoryNameError"></div>
                    </div>

                    <div class="mb-3">
                        <label for="Description" class="form-label">Description</label>
                        <textarea class="form-control" id="Description" name="Description" rows="3"></textarea>
                        <div class="invalid-feedback" id="DescriptionError"></div>
                    </div>

                    <button type="submit" class="btn btn-primary">Save</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(function () {

            // Clear validation messages
            function clearValidation() {
                $(".invalid-feedback").text("").hide();
                $("#CategoryName, #Description").removeClass("is-invalid");
            }

            // Open Add modal
            function openAdd() {
                $("#categoryForm")[0].reset();
                $("#CategoryID").val("");
                clearValidation();
                $("#categoryModal").modal("show");
            }

            // Open Edit modal
            function openEdit(id, name, desc) {
                $("#CategoryID").val(id);
                $("#CategoryName").val(name);
                $("#Description").val(desc);
                clearValidation();
                $("#categoryModal").modal("show");
            }

            // Click handlers
            $(document).on('click', '#btnAdd, #btnAddCategory, .btn-success', function (e) {
                e.preventDefault();
                openAdd();
            });

            $(document).on('click', '.edit-category', function (e) {
                e.preventDefault();
                var $btn = $(this);
                openEdit($btn.data('id'), $btn.data('name') || "", $btn.data('desc') || "");
            });

            // Delete with SweetAlert
            $(document).on('click', '.delete-category', function (e) {
                e.preventDefault();
                var $btn = $(this);
                var id = $btn.data('id');
                var $row = $btn.closest('tr');

                if (!id) return;

                Swal.fire({
                    title: 'Are you sure?',
                    text: "This action cannot be undone!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Yes, delete it!',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '/Category/DeleteAjax',
                            type: 'POST',
                            data: { id: id },
                            success: function (res) {
                                if (res && res.success) {
                                    $row.fadeOut(200, function () { $(this).remove(); });
                                    Swal.fire('Deleted!', 'The category has been deleted.', 'success');
                                } else {
                                    var msg = (res && res.message) ? res.message : "Delete failed.";
                                    Swal.fire('Error!', msg, 'error');
                                }
                            },
                            error: function (xhr) {
                                var txt = xhr && xhr.responseText ? xhr.responseText : "Error deleting category.";
                                Swal.fire('Error!', txt, 'error');
                            }
                        });
                    }
                });
            });

            // Remove invalid class on input
            $(document).on('input', '#CategoryName, #Description', function () {
                $(this).removeClass("is-invalid");
                $(this).siblings(".invalid-feedback").hide().text("");
            });

            // Submit form (Create / Edit)
            $("#categoryForm").off('submit').on('submit', function (e) {
                e.preventDefault();
                clearValidation();

                var nameInput = $("#CategoryName");
                var descInput = $("#Description");
                var name = nameInput.val().trim();
                var desc = descInput.val().trim();
                var id = $("#CategoryID").val();
                var isValid = true;

                // Validate Category Name
                if (name === "") {
                    $("#CategoryNameError").text("Category name is required.").show();
                    nameInput.addClass("is-invalid");
                    isValid = false;
                } else if (name.length < 3) {
                    $("#CategoryNameError").text("Category name must be at least 3 characters.").show();
                    nameInput.addClass("is-invalid");
                    isValid = false;
                }

                // Validate Description
                if (desc.length > 200) {
                    $("#DescriptionError").text("Description must be less than 200 characters.").show();
                    descInput.addClass("is-invalid");
                    isValid = false;
                }

                if (!isValid) return;

                var url = (id && id !== "0") ? '/Category/EditAjax' : '/Category/CreateAjax';

                $.ajax({
                    url: url,
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function (respHtml) {
                        $("#categoryTable").html(respHtml);
                        $("#categoryModal").modal("hide");
                        $("#categoryForm")[0].reset();
                        $("#CategoryID").val("");
                        clearValidation();
                    },
                    error: function (xhr) {
                        var message = xhr && xhr.responseText ? xhr.responseText : "An error occurred.";
                        Swal.fire('Error!', message, 'error');
                    }
                });
            });

            // Remove invalid class on typing
            $(document).on('input', '#CategoryName, #Description', function () {
                $(this).removeClass("is-invalid");
                $(this).siblings(".invalid-feedback").hide().text("");
            });
    </script>
}
