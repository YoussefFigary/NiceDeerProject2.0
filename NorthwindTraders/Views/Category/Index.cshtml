@model IEnumerable<Northwind.DTO.CategoryVM>


@{
    ViewBag.Title = "Categories";
}

<div class="container mt-4">
    <h2>Categories</h2>

    <div class="mb-3">
        <button class="btn btn-success" id="btnAddCategory">
            Add New Category
        </button>
    </div>

    <div id="categoryTable">
        @Html.Partial("_CategoryTable", Model)
    </div>
</div>


<!-- Modal -->
<div class="modal fade" id="categoryModal" tabindex="-1" aria-labelledby="categoryModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="categoryModalLabel">Add / Edit Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <form id="categoryForm" novalidate>
                    <input type="hidden" id="CategoryID" name="CategoryID" />

                    <div class="form-group">
                        <label for="CategoryName">Category Name</label>
                        <input type="text" id="CategoryName" name="CategoryName" class="form-control" />
                        <span id="CategoryNameError" class="text-danger" style="display:none;"></span>
                    </div>

                    <div class="form-group mt-2">
                        <label for="Description">Description</label>
                        <textarea id="Description" name="Description" class="form-control"></textarea>
                        <span id="DescriptionError" class="text-danger" style="display:none;"></span>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="saveCategory">Save</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            </div>

        </div>
    </div>
</div>


@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(function () {

            // ✅ Clear validation
            function clearValidation() {
                $(".invalid-feedback").text("").hide();
                $("#CategoryName, #Description").removeClass("is-invalid");
            }

            // ✅ Validation function
            function validateCategoryForm() {
                let isValid = true;

                let nameInput = $("#CategoryName");
                let nameError = $("#CategoryNameError");
                let nameVal = nameInput.val().trim();

                if (nameVal === "") {
                    nameInput.addClass("is-invalid");
                    nameError.show().text("Category name is required.");
                    isValid = false;
                } else if (nameVal.length < 3) {
                    nameInput.addClass("is-invalid");
                    nameError.show().text("Category name must be at least 3 characters.");
                    isValid = false;
                } else {
                    nameInput.removeClass("is-invalid");
                    nameError.hide().text("");
                }

                let descInput = $("#Description");
                let descError = $("#DescriptionError");
                let descVal = descInput.val().trim();

                if (descVal === "") {
                    descInput.addClass("is-invalid");
                    descError.show().text("Description is required.");
                    isValid = false;
                } else if (descVal.length > 200) {
                    descInput.addClass("is-invalid");
                    descError.show().text("Description must be less than 200 characters.");
                    isValid = false;
                } else {
                    descInput.removeClass("is-invalid");
                    descError.hide().text("");
                }

                return isValid;
            }

            $(document).ready(function () {
                $("#saveCategory").click(function (e) {
                    e.preventDefault();

                    if (validateCategoryForm()) {
                        // لو كل حاجة صح، بعت الفورم
                        $("#categoryForm").submit();
                    }
                });
            });

            
            // ✅ Open Add modal
            function openAdd() {
                $("#categoryForm")[0].reset();
                $("#CategoryID").val("");
                clearValidation();

                var myModal = new bootstrap.Modal(document.getElementById('categoryModal'));
                myModal.show();
            }

            // ✅ Open Edit modal
            function openEdit(id, name, desc) {
                $("#CategoryID").val(id);
                $("#CategoryName").val(name);
                $("#Description").val(desc);
                clearValidation();

                var myModal = new bootstrap.Modal(document.getElementById('categoryModal'));
                myModal.show();
            }


            // ✅ Click handlers
            $(document).on('click', '#btnAddCategory', function (e) {
                e.preventDefault();
                openAdd();
            });

            $(document).on('click', '.edit-category', function (e) {
                e.preventDefault();
                let $btn = $(this);
                openEdit($btn.data('id'), $btn.data('name') || "", $btn.data('desc') || "");
            });

            // ✅ Delete with SweetAlert
            $(document).on('click', '.delete-category', function (e) {
                e.preventDefault();
                let $btn = $(this);
                let id = $btn.data('id');
                let $row = $btn.closest('tr');

                if (!id) return;

                Swal.fire({
                    title: 'Are you sure?',
                    text: "This action cannot be undone!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Yes, delete it!',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '/Category/DeleteAjax',
                            type: 'POST',
                            data: { id: id },
                            success: function (res) {
                                if (res && res.success) {
                                    $row.fadeOut(200, function () { $(this).remove(); });
                                    Swal.fire('Deleted!', 'The category has been deleted.', 'success');
                                } else {
                                    let msg = (res && res.message) ? res.message : "Delete failed.";
                                    Swal.fire('Error!', msg, 'error');
                                }
                            },
                            error: function (xhr) {
                                let txt = xhr && xhr.responseText ? xhr.responseText : "Error deleting category.";
                                Swal.fire('Error!', txt, 'error');
                            }
                        });
                    }
                });
            });

            // ✅ Submit form
            $("#categoryForm").off("submit").on("submit", function (e) {
                e.preventDefault();

                if (!validateCategoryForm()) return; // Stop if not valid

                let id = $("#CategoryID").val();
                let url = (id && id !== "0") ? '/Category/EditAjax' : '/Category/CreateAjax';

                $.ajax({
                    url: url,
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function (respHtml) {
                        $("#categoryTable").html(respHtml);
                        $("#categoryModal").modal("hide");
                        $("#categoryForm")[0].reset();
                        $("#CategoryID").val("");
                    },
                    error: function (xhr) {
                        let message = xhr && xhr.responseText ? xhr.responseText : "An error occurred.";
                        Swal.fire('Error!', message, 'error');
                    }
                });
            });

            // ✅ Remove invalid class while typing
            $(document).on('input', '#CategoryName, #Description', function () {
                $(this).removeClass("is-invalid");
                $(this).siblings(".invalid-feedback").hide().text("");
            });
        });
    </script>
}
