<script>
    // Validation function
    function validateForm() {
        let input = $("#RegionDescription");
        let errorSpan = $("#RegionDescriptionError");
        let desc = input.val().trim();

        if (desc.length < 3) {
            input.addClass("is-invalid");
            errorSpan.show().text("Description must be at least 3 characters");
            return false;
        } else if (desc.length > 100) {
            input.addClass("is-invalid");
            errorSpan.show().text("Description must be less than 100 characters");
            return false;
        } else {
            input.removeClass("is-invalid");
            errorSpan.hide().text("");
            return true;
        }
    }

    // ✅ Create
    function openCreateModal() {
        $("#regionModalLabel").text("Add Region");
        $("#RegionID").val("0");
        $("#RegionDescription").val("").removeClass("is-invalid");
        $("#RegionDescriptionError").hide().text("");

        $("#regionForm").off("submit").on("submit", function (e) {
            e.preventDefault();
            if (!validateForm()) return;

            $.ajax({
                url: '@Url.Action("CreateAjax", "Region")',
                type: "POST",
                data: $(this).serialize(),
                success: function (result) {
                    $("#regionTableContainer").html(result);
                    $("#regionModal").modal("hide");
                },
                error: function (xhr) {
                    let msg = xhr.responseJSON?.message || xhr.responseText || "Error occurred";
                    Swal.fire("Error", msg, "error");
                }
            });
        });

        $("#regionModal").modal("show");
    }

    // ✅ Edit
    function openEditModal(id, description) {
        $("#regionModalLabel").text("Edit Region");
        $("#RegionID").val(id);
        $("#RegionDescription").val(description).removeClass("is-invalid");
        $("#RegionDescriptionError").hide().text("");

        $("#regionForm").off("submit").on("submit", function (e) {
            e.preventDefault();
            if (!validateForm()) return;

            $.ajax({
                url: '@Url.Action("EditAjax", "Region")',
                type: "POST",
                data: $(this).serialize(),
                success: function (result) {
                    $("#regionTableContainer").html(result);
                    $("#regionModal").modal("hide");
                },
                error: function (xhr) {
                    let msg = xhr.responseJSON?.message || xhr.responseText || "Error occurred";
                    Swal.fire("Error", msg, "error");
                }
            });
        });

        $("#regionModal").modal("show");
    }

    // ✅ Delete
function deleteRegion(id) {
    Swal.fire({
        title: "Are you sure?",
        text: "This action cannot be undone",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#d33",
        confirmButtonText: "Yes, delete it!"
    }).then((result) => {
        if (result.isConfirmed) {
            $.post('@Url.Action("DeleteAjax", "Region")', { id: id })
                .done(function (res) {
                    if (res.success) {
                        
                        $("#regionTableContainer").load('@Url.Action("Index", "Region") #regionTableContainer');
                        Swal.fire("Deleted!", "Region has been deleted.", "success");
                    } else {
                        Swal.fire("Error", res.message, "error");
                    }
                })
                .fail(function (xhr) {
                    Swal.fire("Error", xhr.responseText, "error");
                });
        }
    });
}

</script>
