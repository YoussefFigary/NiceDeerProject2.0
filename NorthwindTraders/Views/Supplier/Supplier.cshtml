@model IEnumerable<NorthwindTraders.Models.Supplier>

<head>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

</head>
<main>
    <div class="d-flex align-items-center mb-3">
        <h1 class="display-4 mb-0 me-3" style="line-height: 1;">Suppliers</h1>
        <button type="button" class="btn btn-success btn-lg" onclick="AddOrEditSupplier(0)">Add Supplier</button>
    </div>



    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Supplier ID</th>
                <th>Company Name</th>
                <th>City</th>
                <th>Country</th>
                <th>Phone</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.SupplierID</td>
                    <td>@item.CompanyName</td>
                    <td>@item.City</td>
                    <td>@item.Country</td>
                    <td>@item.Phone</td>
                   <td>
                       <div class="btn-group">
                           <button type="button" class="btn btn-dark" onclick="customerDetails(@item.SupplierID)"> <i class="bi bi-eye-fill"></i></button>
                           <button type="button" class="btn btn-primary" onclick="AddOrEditSupplier(@item.SupplierID)"><i class="bi bi-pencil-fill"></i></button>
                           <button type="button" class="btn btn-danger" onclick="DeleteSupplierpopup(@item.SupplierID)"><i class="bi bi-trash3-fill"></i></button>
                       </div>
                   </td>
                    

                </tr>
            }
        </tbody>
    </table>

</main>
<div class="modal fade" id="SupplierEditModal" tabindex="-1" aria-labelledby="SupplierEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="SupplierEditModalLabel"></h5> <!-- title will be set dynamically -->
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body" id="SupplierEditModalBody">
                <!-- Partial view will load here -->
            </div>



        </div>
    </div>
</div>
<script>
    function DeleteSupplierpopup(id) {
        Swal.fire({
            title: "Are you sure?",
            text: "You won't be able to revert this!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#d33",
            cancelButtonColor: "#3085d6",
            confirmButtonText: "Yes, delete it!"
        }).then((result) => {
            if (result.isConfirmed) {
                DeleteSupplier(id);
            }
        });
    }
    function DeleteSupplier(id) {
        $.ajax({
            url: `/Supplier/Delete?id=${id}`,
            type: 'POST',
            contentType: 'application/json',
            success: function (data, textStatus, jqXHR) {
                // 200 OK
                Swal.fire('Deleted!', 'The Supplier was deleted.', 'success');
            },
            error: function (jqXHR) {
                // jqXHR.status will be 409 or 404
                if (jqXHR.status === 409) {
                    
                    var data = JSON.parse(jqXHR.responseText);
                    var list = data.linkedProducts
                        .map(function (e) {
                            return '<li>' + e.ProductID + "=>" + e.ProductName + '</li>';
                        })
                        .join('');
                    Swal.fire({
                        icon: 'error',
                        title: "Can Not Delete This Supplier is Linked to the Products below:",
                        html: '<p>' + list + '</p>'
                    });
                }
                else if (jqXHR.status === 404) {
                    var data = JSON.parse(jqXHR.responseText);
                    Swal.fire('Error', data.error, 'error');
                }
                else {
                    Swal.fire('Error', 'Unexpected error occurred', 'error');
                }
            }
        });
    }

   
    function validateAndSaveSupplier(){

       var form = document.getElementById('adddoredit-Supplier-form');

       // check Bootstrap validation
       if (form.checkValidity()) {
           saveSupplier(); // ✅ only call if valid
       } 
       else {
           form.classList.add('was-validated'); // show errors
       }

    }

    function saveSupplier() {
        var formData = $("#adddoredit-Supplier-form").serialize();
        $.ajax({
            url: '/Supplier/SaveEdit',  // POST to save changes
            type: 'POST',
            data: formData,
            success: function (result) {
                if (result.success) {
                    Swal.fire("Success", "Supplier updated successfully!", "success")
                        .then(() => location.reload()); 
                } else {
                    Swal.showValidationMessage("Error updating Supplier");
                }
            },
            error: function () {
                Swal.showValidationMessage("Error while saving Supplier");
            }
        });
    }
    function AddOrEditSupplier(id) {
        debugger;
     $.ajax({
         url: `/Supplier/AddOrEditPopup?id=${id}`,
         type: 'GET',
         dataType: 'html',
         success: function (partialViewHtml) {
             $("#SupplierEditModalBody").html(partialViewHtml);
             // set title depending on add or edit
             if (id === "" || id === null) {
                 $("#SupplierEditModalLabel").text("Add Supplier");
             } else {
                 $("#SupplierEditModalLabel").text("Edit Supplier");
             }

             $("#SupplierEditModal").modal('show');
         },
         error: function () {
             Swal.fire("Error", "Could not load form", "error");
         }
     });
 }
     
    



</script>