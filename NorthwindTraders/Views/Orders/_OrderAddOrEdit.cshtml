﻿@model NorthwindTraders.Models.Order
@{
    var customers = ViewBag.Customers as List<NorthwindTraders.Models.Customer>;
    var employees = ViewBag.Employees as List<NorthwindTraders.Models.Employee>;
    var shippers = ViewBag.Shippers as List<NorthwindTraders.Models.Shipper>;
    var orderDetails = ViewBag.Order_Details as List<NorthwindTraders.Models.Order_Detail>;
    var currentOrderDetail = orderDetails.Where(d => d.OrderID == Model.OrderID);
}

<form id="addoredit-order-form" class="row g-3 needs-validation" novalidate>
    @Html.HiddenFor(m => m.OrderID)

    <!-- Customer -->
    <div class="col-md-6">
        <label class="form-label">Customer</label>
        <select name="CustomerID" class="form-select" required>
            <option selected disabled value="">Choose...</option>
            @foreach (var c in customers ?? new List<NorthwindTraders.Models.Customer>())
            {
                <option value="@c.CustomerID" @(c.CustomerID == Model.CustomerID ? "selected" : "")>
                    @c.CompanyName
                </option>
            }
        </select>
        <div class="invalid-feedback">Customer is required.</div>
    </div>

    <!-- Employee -->
    <div class="col-md-6">
        <label class="form-label">Employee</label>
        <select name="EmployeeID" class="form-select" required>
            <option selected disabled value="">Choose...</option>
            @foreach (var e in employees ?? new List<NorthwindTraders.Models.Employee>())
            {
                <option value="@e.EmployeeID" @(e.EmployeeID == Model.EmployeeID ? "selected" : "")>
                    @e.FirstName @e.LastName
                </option>
            }
        </select>
        <div class="invalid-feedback">Employee is required.</div>
    </div>

    <!-- Order Date -->
    <div class="col-md-4">
        <label class="form-label">Order Date</label>
        <input type="date" name="OrderDate" value="@(Model.OrderDate?.ToString("yyyy-MM-dd"))" class="form-control" required />
        <div class="invalid-feedback">Order Date is required.</div>
    </div>

    <!-- Required Date -->
    <div class="col-md-4">
        <label class="form-label">Required Date</label>
        <input type="date" name="RequiredDate" value="@(Model.RequiredDate?.ToString("yyyy-MM-dd"))" class="form-control" required />
        <div class="invalid-feedback">Required Date is required.</div>
    </div>

    <!-- Shipped Date -->
    <div class="col-md-4">
        <label class="form-label">Shipped Date</label>
        <input type="date" name="ShippedDate" value="@(Model.ShippedDate?.ToString("yyyy-MM-dd"))" class="form-control" />
    </div>

    <!-- Ship Via -->
    <div class="col-md-6">
        <label class="form-label">Ship Via</label>
        <select name="ShipVia" class="form-select" required>
            <option selected disabled value="">Choose...</option>
            @foreach (var s in shippers ?? new List<NorthwindTraders.Models.Shipper>())
            {
                <option value="@s.ShipperID" @(s.ShipperID == Model.ShipVia ? "selected" : "")>
                    @s.CompanyName
                </option>
            }
        </select>
        <div class="invalid-feedback">Ship Via is required.</div>
    </div>

    <!-- Freight -->
    <div class="col-md-6">
        <label class="form-label">Freight</label>
        <input type="number" step="0.01" name="Freight" value="@Model.Freight" class="form-control" placeholder="Freight" />
    </div>

    <!-- Ship Name -->
    <div class="col-md-6">
        <label class="form-label">Ship Name</label>
        <input name="ShipName" value="@Model.ShipName" class="form-control" placeholder="Ship Name" />
    </div>

    <!-- Ship Address -->
    <div class="col-md-6">
        <label class="form-label">Ship Address</label>
        <input name="ShipAddress" value="@Model.ShipAddress" class="form-control" placeholder="Ship Address" />
    </div>

    <!-- Ship City -->
    <div class="col-md-4">
        <label class="form-label">Ship City</label>
        <input name="ShipCity" value="@Model.ShipCity" class="form-control" placeholder="Ship City" required />
        <div class="invalid-feedback">Ship City is required.</div>
    </div>

    <!-- Ship Region -->
    <div class="col-md-4">
        <label class="form-label">Ship Region</label>
        <input name="ShipRegion" value="@Model.ShipRegion" class="form-control" placeholder="Ship Region" />
    </div>

    <!-- Ship Postal Code -->
    <div class="col-md-4">
        <label class="form-label">Ship Postal Code</label>
        <input name="ShipPostalCode" value="@Model.ShipPostalCode" class="form-control" placeholder="Ship Postal Code" />
    </div>

    <!-- Ship Country -->
    <div class="col-md-4">
        <label class="form-label">Ship Country</label>
        <input name="ShipCountry" value="@Model.ShipCountry" class="form-control" placeholder="Ship Country" required />
        <div class="invalid-feedback">Ship Country is required.</div>
    </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button class="btn btn-primary" type="button" data-bs-dismiss="modal" onclick="validateAndSaveOrder()">Save Order</button>
        </div>

    </form>