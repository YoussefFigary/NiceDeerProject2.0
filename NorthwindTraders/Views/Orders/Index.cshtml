
@model IEnumerable<Northwind.DTO.OrderVM>
@{
    ViewBag.Title = "Orders";
}
<head>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @*bootstrap icons*@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>
<main>
    <div class="d-flex align-items-center mb-3">
        <h1 class="display-4 mb-0 me-3" style="line-height: 1;">Orders</h1>
        <button type="button" class="btn btn-success btn-lg" onclick="AddOrEditOrder(0)">Add Order</button>
    </div>



    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Order ID</th>
                <th>Customer </th>
                <th>Employee</th>
                <th>Order Date</th>
                <th>Order City</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.OrderID</td>
                    <td>@item.CustomerID</td>
                    <td>@item.EmployeeID</td>
                    <td>@item.OrderDate</td>
                    <td>@item.ShipCity</td>
                    <td>
                        <div class="btn-group">
                            <button type="button" class="btn btn-dark" onclick="AddOrderDetails('@item.OrderID')"><i class="bi bi-plus-circle"></i></button>
                            <button type="button" class="btn btn-dark" onclick="orderDetails('@item.OrderID')"> <i class="bi bi-eye-fill"></i></button>
                            <button type="button" class="btn btn-primary" onclick="AddOrEditOrder('@item.OrderID')"><i class="bi bi-pencil-fill"></i></button>
                            <button type="button" class="btn btn-danger" onclick="DeleteOrder('@item.OrderID')"><i class="bi bi-trash3-fill"></i></button>
                        </div>

                    </td>
                </tr>
            }
        </tbody>
    </table>
    <!--order detials wrapper-->
    <div class="modal fade" id="orderDetailsModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Order Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="orderDetailsModalBody">
                    <!-- Partial view will load here -->
                </div>
            </div>
        </div>
    </div>
    <!--add or edit wrapper-->
    <div class="modal fade" id="orderAddOrEditModal" tabindex="-1" aria-labelledby="orderAddOrEditModal" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="orderAddOrEditModalLabel"></h5> <!-- title will be set dynamically -->
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body" id="orderAddOrEditModalBody">
                    <!-- Partial view will load here -->
                </div>
            </div>
        </div>
    </div>
    <!-- add details wrapper-->
    <div class="modal fade" id="AddDetailModal" tabindex="-1" aria-labelledby="AddDetailModal" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="AddDetailModalLabel"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body" id="AddDetailModalBody">
                    <!-- Partial view will load here -->
                </div>
            </div>
        </div>
    </div>

</main>
<script>
    function orderDetails(id) {
        $.ajax({
            url: `/Orders/Details?id=${id}`, // Calls OrdersController.Details
            type: 'GET',
            dataType: 'html',
            success: function (partialViewHtml) {
                $("#orderDetailsModalBody").html(partialViewHtml);
                $("#orderDetailsModal").modal('show');
            },
            error: function (xhr, status, error) {
                Swal.fire("Error", "Could not load order details", "error");
            }
        });
    }

    function AddOrderDetails(orderId) {
        $.ajax({
            url: `/Orders/AddOrderDetailPopup?orderId=${orderId}`,
            type: 'GET',
            dataType: 'html',
            success: function (partialViewHtml) {
                $("#AddDetailModalBody").html(partialViewHtml);
                $("#AddDetailModalLabel").text("Add Detail");
                $("#AddDetailModal").modal("show");
            },
            error: function () {
                Swal.fire("Error", "Could not load form", "error");
            }
        });
    }

    function AddOrEditOrder(id) {
        $.ajax({
            url: `/Orders/AddOrEditPopup?id=${id}`,
            type: 'GET',
            dataType: 'html',
            success: function (partialViewHtml) {
                $("#orderAddOrEditModalBody").html(partialViewHtml);
                // set title depending on add or edit
                if (id === 0 || id === "") {
                    $("#orderAddOrEditModalLabel").text("Add Order");
                } else {
                    $("#orderAddOrEditModalLabel").text("Edit Order");
                }

                $("#orderAddOrEditModal").modal('show');
            },
            error: function () {
                Swal.fire("Error", "Could not load form", "error");
            }
        });
    }
    function validateAndSaveOrder() {
        var form = document.getElementById('addoredit-order-form');
        if (form.checkValidity()) {
            saveOrder();
        } else {
            form.classList.add('was-validated');
        }
    }
    //var createdId;
    function saveOrder() {
        var formData = $("#addoredit-order-form").serialize();

        $.ajax({
            url: '/Orders/SaveAddOrEdit',  // POST to save changes
            type: 'POST',
            data: formData,
            success: function (result) {
                if (result.Success) {
                    Swal.fire("Success", "Order updated successfully!", "success")
                        .then(() => location.reload());
                    //createdId = result.OrderId;
                } else {
                    Swal.showValidationMessage("Error updating customer");
                }
            },
            error: function () {
                Swal.showValidationMessage("Error while saving customer");
            }
        });
    }

    function DeleteOrder(id) {
        debugger
        Swal.fire({
            title: "Are you sure?",
            text: "This will permanently delete the order.",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Yes, delete it!",
            cancelButtonText: "Cancel"
        }).then((result) => {
            if (result.isConfirmed) {
                debugger
                $.ajax({
                    url: '/Orders/Delete',
                    type: 'POST',
                    data: { id: id },
                    success: function (result) {
                        if (result.Success) {
                            Swal.fire("Deleted!", result.Message, "success")
                                .then(() => location.reload());
                        } else {
                            Swal.fire("Blocked", result.Message, "error");
                        }
                    },
                    error: function () {
                        Swal.fire("Error", "An error occurred while deleting.", "error");
                    }
                });
            }
        });
    }

    function validateAndSaveDetail() {
        var form = document.getElementById('add-orderDetails-form');
        if (form.checkValidity()) {
            saveDetail();
        } else {
            form.classList.add('was-validated');
        }
    }

    function saveDetail() {
        var formData = $("#add-orderDetails-form").serialize();

        $.ajax({
            url: '/Orders/SaveDetail',
            type: 'POST',
            data: formData,
            success: function (result) {
                if (result.Success) {
                    Swal.fire("Success", "Order detail added successfully!", "success")
                        .then(() => {
                            $("#AddDetailModal").modal("hide"); // close modal
                            location.reload(); // refresh orders page
                        });
                } else {
                    Swal.fire("Error", result.Message || "Could not save order detail", "error");
                }
            },
            error: function () {
                Swal.fire("Error", "Error while saving order detail", "error");
            }
        });
    }

    function DeleteDetail(orderID, productID) {
        Swal.fire({
            title: "Are you sure?",
            text: "This will permanently delete this detail.",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Yes, delete it!",
            cancelButtonText: "Cancel"
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/Orders/DeleteDetail',
                    type: 'POST',
                    data: { orderID: orderID, productID: productID },
                    success: function (result) {
                        if (result.Success) {
                            Swal.fire("Deleted!", result.Message, "success")
                                .then(() => location.reload());
                        } else {
                            Swal.fire("Blocked", result.Message, "error");
                        }
                    },
                    error: function () {
                        Swal.fire("Error", "An error occurred while deleting.", "error");
                    }
                });
            }
        });
    }



