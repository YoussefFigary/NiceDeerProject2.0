<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
@model IEnumerable<Northwind.DTO.ShipperVM>

<div id="shipperTableContainer">
    <table class="table table-striped table-hover no-border-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Company Name</th>
                <th>Phone</th>
                <th style="width:150px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr id="row_@item.ShipperID">
                    <td>@item.ShipperID</td>
                    <td>@item.CompanyName</td>
                    <td>@item.Phone</td>
                    <td>
                        <div class="btn-group" role="group">
                            <button class="btn btn-primary btn-sm"
                                    onclick="openEditShipperModal(@item.ShipperID, '@item.CompanyName', '@item.Phone')"
                                    title="Edit">
                                <i class="bi bi-pencil-fill"></i>
                            </button>
                            <button class="btn btn-danger btn-sm"
                                    onclick="deleteShipper(@item.ShipperID)"
                                    title="Delete">
                                <i class="bi bi-trash-fill"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
