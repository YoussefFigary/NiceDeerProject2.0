<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
@model IEnumerable<NorthwindTraders.Models.Shipper>

<table class="table table-striped table-hover no-border-table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Company Name</th>
            <th>Phone</th>
            <th style="width:150px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr id="row_@item.ShipperID">
                <td>@item.ShipperID</td>
                <td>@item.CompanyName</td>
                <td>@item.Phone</td>
                <td>
                    <div class="btn-group" role="group">
                        <button class="btn btn-primary btn-sm edit-shipper"
                                data-id="@item.ShipperID"
                                title="Edit">
                            <i class="bi bi-pencil-fill"></i>
                        </button>
                        <button class="btn btn-danger btn-sm delete-shipper"
                                data-id="@item.ShipperID"
                                title="Delete">
                            <i class="bi bi-trash-fill"></i>
                        </button>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
