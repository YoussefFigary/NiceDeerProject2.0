<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    
    function validateShipperForm(companyName, phone) {
        if (!companyName || companyName.trim().length < 3) {
            Swal.showValidationMessage("Company Name must be at least 3 characters long.");
            return false;
        }

        if (!phone || !/^[0-9+\-() ]{5,}$/.test(phone)) {
            Swal.showValidationMessage("Please enter a valid phone number (min 5 digits).");
            return false;
        }

        return true;
    }

    //  Add Shipper
    $("#addShipper").click(function () {
        Swal.fire({
            title: "Add Shipper",
            html:
                '<input id="companyName" class="swal2-input" placeholder="Company Name">' +
                '<input id="phone" class="swal2-input" placeholder="Phone">',
            showCancelButton: true,
            confirmButtonText: "Save",
            preConfirm: () => {
                let companyName = document.getElementById('companyName').value;
                let phone = document.getElementById('phone').value;

                if (!validateShipperForm(companyName, phone)) {
                    return false; 
                }

                return {
                    CompanyName: companyName,
                    Phone: phone
                };
            }
        }).then((result) => {
            if (result.isConfirmed) {
                $.post("/Shipper/CreateAjax", result.value, function (data) {
                    $("#shipperTableContainer").html(data);
                }).fail(function (xhr) {
                    Swal.fire("Error", xhr.statusText, "error");
                });
            }
        });
    });

    // Edit Shipper
    $(document).on("click", ".edit-shipper", function () {
        var id = $(this).data("id");
        var row = $(this).closest("tr");
        var companyName = row.find("td:eq(1)").text().trim();
        var phone = row.find("td:eq(2)").text().trim();

        Swal.fire({
            title: "Edit Shipper",
            html:
                '<input id="companyName" class="swal2-input" value="' + companyName + '">' +
                '<input id="phone" class="swal2-input" value="' + phone + '">',
            showCancelButton: true,
            confirmButtonText: "Update",
            preConfirm: () => {
                let newCompanyName = document.getElementById('companyName').value;
                let newPhone = document.getElementById('phone').value;

                if (!validateShipperForm(newCompanyName, newPhone)) {
                    return false;
                }

                return {
                    ShipperID: id,
                    CompanyName: newCompanyName,
                    Phone: newPhone
                };
            }
        }).then((result) => {
            if (result.isConfirmed) {
                $.post("/Shipper/EditAjax", result.value, function (data) {
                    $("#shipperTableContainer").html(data);
                }).fail(function (xhr) {
                    Swal.fire("Error", xhr.statusText, "error");
                });
            }
        });
    });

</script>
