                    function Deleteemployeepopup(id) {
                        Swal.fire({
                            title: "Are you sure?",
                            text: "You won't be able to revert this!",
                            icon: "warning",
                            showCancelButton: true,
                            confirmButtonColor: "#d33",
                            cancelButtonColor: "#3085d6",
                            confirmButtonText: "Yes, delete it!"
                        }).then((result) => {
                            if (result.isConfirmed) {
                                Deleteemployee(id);
                            }
                        });
                    }
                    function Deleteemployee(id) {
                        $.ajax({
                            url: `/Employees/Delete?id=${id}`,
                            type: 'POST',
                            contentType: 'application/json',
                            success: function (data, textStatus, jqXHR) {
                                // 200 OK
                                Swal.fire('Deleted!', 'The Employee was deleted.', 'success')
                                    .then(() => location.reload());
                            },
                            error: function (jqXHR) {
                                // jqXHR.status will be 409 or 404
                               
                                if (jqXHR.status === 409) {

                                    var data = JSON.parse(jqXHR.responseText);
                                    if (data.linkedorders) {
                                        var list = data.linkedorders
                                            .map(function (e) {
                                                return '<li>' + e.OrderID + "=>" + e.CompanyName + '</li>';
                                            })
                                            .join('');
                                        Swal.fire({
                                            icon: 'error',
                                            title: "Can Not Delete This Employee is Linked to the Orders below:",
                                            html: '<p>' + list + '</p>'
                                        });
                                    }
                                    else if (data.linkedemployees) {
                                        var list = data.linkedemployees
                                            .map(function (e) {
                                                return '<li>' + e.EmployeeID + "=>" + e.FullName + '</li>';
                                            })
                                            .join('');
                                        Swal.fire({
                                            icon: 'error',
                                            title: "Can Not Delete This Employee is Linked to the Employees below:",
                                            html: '<p>' + list + '</p>'
                                        });

                                    }

                                }
                                

                                else if (jqXHR.status === 404) {
                                    var data = JSON.parse(jqXHR.responseText);
                                    Swal.fire('Error', data.error, 'error');
                                }
                                else {
                                    Swal.fire('Error', 'Unexpected error occurred', 'error');
                                }
                            }
                        });
                    }


                    function validateAndSaveemployee() {

                        debugger;


                        var form = document.getElementById('adddoredit-Employee-form');

                        // check Bootstrap validation
                        if (form.checkValidity()) {
                            saveemployee(); // ✅ only call if valid
                        }
                        else {
                            form.classList.add('was-validated'); // show errors
                        }

                    }

    function saveemployee() {
        debugger;
                        var formData = $("#adddoredit-Employee-form").serialize();
                       
                        $.ajax({
                            url: '/Employees/SaveEdit',  // POST to save changes
                            type: 'POST',
                            data: formData,
                            success: function (result) {
                                if (result.success) {
                                    Swal.fire("Success", "Employee updated successfully!", "success")
                                        .then(() => location.reload());
                                } else {
                                    Swal.showValidationMessage("Error updating Employee");
                                }
                            },
                            error: function () {
                                Swal.showValidationMessage("Error while saving Employee");
                            }
                        });
                    }
                    function AddOrEditemployee(id) {

                        $.ajax({
                            url: `/Employees/AddOrEditPopup?id=${id}`,
                            type: 'GET',
                            dataType: 'html',
                            success: function (partialViewHtml) {
                                $("#employeeEditModalBody").html(partialViewHtml);
                                // set title depending on add or edit
                                if (id === "" || id === null) {
                                    $("#employeeEditModalLabel").text("Add Employee");
                                } else {
                                    $("#employeeEditModalLabel").text("Edit Employee");
                                }

                                $("#employeeEditModal").modal('show');
                            },
                            error: function () {
                                Swal.fire("Error", "Could not load form", "error");
                            }
                        });
                    }

                    function employeeDetails(id) {
                        $.ajax({
                            url: `/Employees/Details?id=${id}`,// Calls CustomersController.Details
                            type: 'GET',
                            dataType: 'html',
                            success: function (partialViewHtml) {
                                $("#employeeDetailsModalBody").html(partialViewHtml);
                                $("#employeeDetailsModal").modal('show');
                            },
                            error: function (xhr, status, error) {
                                Swal.fire("Error", "Could not load customer details", "error");
                            }
                        });
                    }




</script>
