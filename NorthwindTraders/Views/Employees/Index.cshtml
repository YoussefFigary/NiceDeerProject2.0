@model IEnumerable<Northwind.DTO.EmployeeVM>

<head>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

</head>
<main>
    <div class="d-flex align-items-center mb-3">
        <h1 class="display-4 mb-0 me-3" style="line-height: 1;">Employees</h1>
        <button type="button" class="btn btn-success btn-lg" onclick="AddOrEditemployee(0)">Add Employee</button>
    </div>



    <table class="table table-striped table-">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Title</th>
                <th>HomePhone</th>
                <th>ReportsTo</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.EmployeeID</td>
                    <td>@(item.TitleOfCourtesy+item.FirstName+" "+item.LastName) </td>
                    <td>@item.Title</td>
                    <td>@item.HomePhone</td>
                    <td id="MangerFeild">@(item.ReportsToName ?? "He is the Boss")</td>
                    <td>
                        <div class="btn-group">
                            <button type="button" class="btn btn-dark" onclick="employeeDetails(@item.EmployeeID)"> <i class="bi bi-eye-fill"></i></button>
                            <button type="button" class="btn btn-primary" onclick="AddOrEditemployee(@item.EmployeeID)"><i class="bi bi-pencil-fill"></i></button>
                            <button type="button" class="btn btn-danger" onclick="Deleteemployeepopup(@item.EmployeeID)"><i class="bi bi-trash3-fill"></i></button>
                        </div>
                    </td>


                </tr>
            }
        </tbody>
    </table>

</main>
<div class="modal fade" id="employeeEditModal" tabindex="-1" aria-labelledby="employeeEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="employeeEditModalLabel"></h5> <!-- title will be set dynamically -->
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body" id="employeeEditModalBody">
                <!-- Partial view will load here -->
            </div>



        </div>
    </div>
</div>

<div class="modal fade" id="employeeDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Employee Details</h5>
                <!--<button type="button" class="close" data-BS-dismiss="modal">&times;</button>-->
            </div>

            <div id="employeeDetailsModalBody" class="modal-body">
                <!-- Partial view will load here -->
            </div>

        </div>
    </div>
</div>

<script>
  
